    "margem": { "topo": "26mm", "base": "24mm", "esquerda": "22mm", "direita": "22mm" }
  },

  "texto": {
    "familia": "Libertinus Serif",
    "tamanho": "10.5pt",
    "cor": "#1c1917",
    "idioma": "pt"
  },

  "paragrafo": { "justificado": false, "entrelinha": "0.65em", "espacoEntre": "9pt" },

  "titulos": [
    { "nivel": 1, "familia": "Libertinus Sans", "tamanho": "18pt",
      "alinhamento": "esquerda", "espacoAntes": "0pt", "espacoDepois": "20pt" },
