<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AppTemplate.Contatos</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="MongoDB.Driver" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Traz transitivamente:
        Microsoft.Extensions.* (Configuration, DI, Options, Logging),
        IHttpContextAccessor (Infrastructure/Tenancy).
      FrameworkReference referencia tipos do runtime compartilhado
      ASP.NET Core, sem inchar o binario.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
