# ====================================================================
# MarkDocs — variáveis de ambiente. Copie para `.env` (o Program.cs o
# carrega subindo a árvore de diretórios). Em produção, defina-as no
# ambiente do processo. A tabela completa está no README.
# ====================================================================

# --- MongoDB (single-tenant: um database só) ---
DOCUMENTOS_CONNECTION_STRING=mongodb://localhost:27017
DOCUMENTOS_DATABASE_NAME=markdocs

# --- Armazenamento de objetos (imagens, timbres) ---
# minio = MinIO ou qualquer serviço compatível com a API do S3
# disco = uma pasta local (ARMAZENAMENTO_DIRETORIO), para desenvolvimento
ARMAZENAMENTO_PROVEDOR=minio

# MinIO — os valores batem com o docker-compose.yml.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=markdocs
MINIO_SECRET_KEY=markdocs-segredo
MINIO_BUCKET=markdocs
MINIO_USAR_SSL=false
# MINIO_REGIAO=

# Quando ARMAZENAMENTO_PROVEDOR=disco:
# ARMAZENAMENTO_DIRETORIO=dados/objetos

# --- O assistente (Docs/decisoes-arquitetura/EI-001) ---
# Sem AGENTE_MODELO o app sobe igual, sem o assistente (o painel explica o que falta).
# openai  = a API da OpenAI (ou um serviço compatível em AGENTE_ENDPOINT)
# foundry = um modelo implantado no Microsoft Foundry (Azure OpenAI), pela API v1
# AGENTE_PROVEDOR=openai
# AGENTE_MODELO=gpt-4.1
# AGENTE_CHAVE_API=sk-...
# AGENTE_ENDPOINT=
#
# No Foundry: AGENTE_MODELO é o nome da implantação e AGENTE_ENDPOINT o recurso
# (https://<recurso>.openai.azure.com ou https://<recurso>.services.ai.azure.com).
# Sem AGENTE_CHAVE_API, a autenticação é por Entra ID (az login / identidade gerenciada).
# AGENTE_PROVEDOR=foundry
# AGENTE_ENDPOINT=https://meu-recurso.openai.azure.com
# AGENTE_MODELO=gpt-4.1-markdocs
# AGENTE_CHAVE_API=

# --- Web ---
# Só se o frontend for servido de outro host (em dev, o Vite repassa /api).
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Testes ---
# Um MongoDB próprio para os testes, em vez do mongod efêmero.
# MONGODB_TEST_URI=mongodb://localhost:27017
