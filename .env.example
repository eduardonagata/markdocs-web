# ====================================================================
# Variáveis lidas via IConfiguration (appsettings.json, .env, env vars).
# Copie este arquivo para `.env` e preencha conforme o ambiente.
# ====================================================================

# --- MongoDB ---
# No template, o slice Contatos é o único exemplo de referência e
# traz CONTATOS_CONNECTION_STRING como demonstração do padrão
# <SLICE>_CONNECTION_STRING. Cada novo slice que use MongoDB expõe
# sua própria variável: COMPRAS_CONNECTION_STRING, VENDAS_CONNECTION_STRING, etc.
#
# Flexibilidade por deploy:
#   - Todas as <SLICE>_CONNECTION_STRING apontando para a MESMA URI
#     = um único MongoDB compartilhado entre slices (caso comum).
#   - Cada uma apontando para URIs DIFERENTES = cluster por slice
#     (útil quando o slice foi extraído para outro repo/serviço ou
#      tem requisito de isolamento por jurisdição/carga).
#
# O database é sempre tid-{tenantId} (convenção fixa do template,
# resolvida em runtime via ITenantAccessor).
CONTATOS_CONNECTION_STRING=mongodb://localhost:27017/?replicaSet=rs0

# --- JWT Bearer (produção) ---
# Em dev, estes são ignorados — o JwtBearer usa DEV_JWT_SIGNING_KEY.
JWT_AUTHORITY=https://auth.example.com
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=<produto>-api

# --- JWT Bearer (dev, via AppTemplate.TestStubs) ---
# Facility genérico do template: qualquer endpoint com .RequireAuthorization()
# é consumido autenticando contra o JWT emitido por POST /api/dev/login,
# que é assinado com esta chave e carrega claim tid = DEV_JWT_TENANT_ID.
# Não é específico do slice Contatos — acontece apenas que, neste template,
# Contatos é o único slice de exemplo que consome e valida o JWT.
#
# Defina DEV_JWT_SIGNING_KEY com pelo menos 32 bytes (openssl rand -hex 32).
# Se ausente, o TestStubs gera uma chave volátil por processo (reinicia =
# JWTs anteriores viram inválidos). Em equipe, fixar acelera o ciclo dev.
# DEV_JWT_SIGNING_KEY=<cole aqui 32+ bytes aleatórios>
# DEV_JWT_TENANT_ID=dev
# DEV_JWT_ISSUER=apptemplate-dev
# DEV_JWT_AUDIENCE=apptemplate-api
# DEV_JWT_EXPIRATION_HOURS=24

# --- CORS ---
# Em dev, incluir o dev server do frontend.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Integrações opcionais ---
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# REDIS_CONNECTION_STRING=
